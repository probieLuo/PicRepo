<prism:PrismApplication
    x:Class="PicRepo.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="clr-namespace:PicRepo.Client.Converters"
    xmlns:local="clr-namespace:PicRepo.Client"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:tb="http://www.hardcodet.net/taskbar">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />

                <ResourceDictionary Source="/Controls/CustomWindow.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--  托盘图标资源  -->
            <tb:TaskbarIcon
                x:Key="TrayIcon"
                DoubleClickCommand="{Binding ShowWindowCommand}"
                IconSource="/App.ico"
                ToolTipText="PicRepo">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding ShowWindowCommand}" Header="显示主窗口" />
                        <Separator />
                        <MenuItem Command="{Binding ExitCommand}" Header="退出" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <cvt:DataUnitValuesConverter x:Key="DataUnitValuesConverter" />
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>