<Window
    x:Class="PicRepo.Client.Views.WinMini"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:PicRepo.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="WinMini"
    Width="60"
    Height="60"
    prism:ViewModelLocator.AutoWireViewModel="True"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Clip>
        <EllipseGeometry
            Center="30,30"
            RadiusX="30"
            RadiusY="30" />
    </Window.Clip>

    <Grid>
        <Border
            Background="#8080ff"
            BorderBrush="White"
            BorderThickness="3"
            CornerRadius="30"
            Cursor="Hand"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            MouseLeftButtonUp="Border_MouseLeftButtonUp"
            MouseMove="Border_MouseMove">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding OpenMainWinCommand}" Header="打开主窗口" />
                    <MenuItem Command="{Binding HideWinCommand}" Header="隐藏窗口" />
                    <Separator />
                    <MenuItem Command="{Binding ExitCommand}" Header="退出" />
                </ContextMenu>
            </Border.ContextMenu>
        </Border>
    </Grid>
</Window>